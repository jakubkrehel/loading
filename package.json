{
  "name": "loading-dev",
  "version": "0.3.5",
  "description": "A lightweight library full of beautiful loading indicators for React.",
  "keywords": [
    "react",
    "spinner",
    "loading",
    "loader",
    "indicator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakubkrehel/loading.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:web": "pnpm --filter web build",
    "check": "pnpm lint && biome check --error-on-warnings .",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:lib": "tsup --watch src",
    "dev:web": "pnpm --filter web dev",
    "fix": "oxlint --fix . && biome check --write .",
    "format": "biome format --write .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity error .",
    "prepublishOnly": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm build && pnpm --filter web typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "1.86.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "ultracite": "7.12.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
