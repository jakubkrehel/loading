{
  "name": "consumer-example",
  "private": true,
  "description": "Installs loading-dev from the npm registry to verify a published release works for real consumers. Deliberately excluded from the pnpm workspace.",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3001",
    "start": "next start --port 3001",
    "verify": "npm install loading-dev@latest --no-save && next build"
  },
  "dependencies": {
    "loading-dev": "latest",
    "next": "^16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
