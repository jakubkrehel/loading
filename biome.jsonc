{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "linter": {
    // Oxlint owns JavaScript and TypeScript; Biome still formats and organizes them.
    "includes": ["**", "!**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"],
    "rules": {
      "suspicious": {
        "useBaseline": {
          "level": "error",
          "options": {
            "allowProperties": ["mask-image"],
            "allowSelectors": ["selection"]
          }
        }
      }
    }
  }
}
